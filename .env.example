# Django secret key — generate a real one before deploying, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Never leave this on in production.
DJANGO_DEBUG=False
 
# Comma-separated list of hostnames this site is allowed to answer as.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*

# Comma-separated list of origins Django trusts for POST requests (admin
# login, contact form, language switcher) — required in addition to
# ALLOWED_HOSTS whenever the site is reached through a reverse proxy/tunnel
# with its own domain (cloudflared, ngrok, Nginx on a real domain, ...).
# Supports wildcard subdomains, e.g. https://*.trycloudflare.com.
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
