  payment_db.creator_daily_stats
  payment_db.saved_cards
  payment_db.subscriptions
  payment_db.payments
  payment_db.donations
  payment_db.ppv_purchases
  payment_db.refunds
  payment_db.payout_cards
  payment_db.payouts
  payment_db.ledger_entries
  payment_db.webhook_events
  payment_db.reconciliation_reports
  payment_db.reconciliation_items
  payment_db.outbox
}

TableGroup notify_db_group [color: #8b5cf6] {
  notify_db.recipients
  notify_db.devices
  notify_db.notification_settings
  notify_db.notification_templates
  notify_db.notifications
  notify_db.notification_deliveries
}


// ---------------------------------------------------------------------
// Logical cross-database references (UUID only, NO foreign key).
// Kept so dbdiagram draws the lines; do not create FKs from these.
// ---------------------------------------------------------------------

Ref: users_db.users.id - keycloak.user_entity.id
Ref: content_db.creator_profiles.creator_id - users_db.creators.id
Ref: payment_db.creator_accounts.creator_id - users_db.creators.id
Ref: notify_db.recipients.user_id - users_db.users.id
Ref: content_db.post_media.media_id > media_db.media.id
Ref: media_db.media.owner_id > users_db.users.id
Ref: payment_db.ppv_purchases.post_id > content_db.posts.id
Ref: payment_db.payments.user_id > users_db.users.id
Ref: payment_db.subscriptions.user_id > users_db.users.id
Ref: content_db.comments.user_id > users_db.users.id
