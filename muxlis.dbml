}

TableGroup media_db_group [color: #f59e0b] {
  media_db.media
  media_db.upload_parts
  media_db.media_renditions
  media_db.outbox
}

TableGroup payment_db_group [color: #ef4444] {
  payment_db.platform_settings
  payment_db.creator_accounts
